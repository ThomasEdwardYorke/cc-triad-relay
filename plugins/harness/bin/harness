#!/usr/bin/env node
/**
 * bin/harness — Claude Code Harness CLI
 *
 * Subcommands:
 *   harness init                  Create harness.config.json interactively
 *   harness check                 Verify plugin install integrity
 *   harness doctor                Diagnose local environment
 *   harness rules list            List active guardrail rules
 *   harness rules test <command>  Dry-run a bash command against R01-R13
 *   harness model resolve <agent> Print effective Codex model for <agent> (JSON).
 *                                  When <agent> is `image-gen` or `image-edit`, dispatches
 *                                  to the image resolver and prints {model, reasoningEffort,
 *                                  backend, source, ...}.
 *   harness model check [--strict]  Flag deprecated models vs ~/.codex/models_cache.json
 *   harness migrate [--from PATH] Migrate legacy v2 state to the v3 JSON store
 *   harness worktree-mux [--multiplexer=cmux|tmux|auto] [--with-claude]
 *                                 Open every git worktree in cmux (preferred)
 *                                 or tmux. Falls back to a text listing when
 *                                 neither multiplexer is installed.
 *   harness pr-metrics --pr-range <from>..<to>
 *                                 Collect pull-request review metrics
 *   harness --version
 */

import {
  existsSync,
  readFileSync,
  writeFileSync,
  statSync,
  mkdirSync,
  readdirSync,
} from "node:fs";
import { basename, dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { homedir } from "node:os";
import { execFileSync } from "node:child_process";

const __dirname = dirname(fileURLToPath(import.meta.url));

// Resolve the plugin root directory. Prefer the directory adjacent to `bin/`
// (standard install) and fall back to `CLAUDE_PLUGIN_ROOT` when the CLI is
// invoked inside a hook whose working tree points at a different install.
// Both `resolveCorePath()` and `cmdCheck()` must share this logic so that
// the integrity report and the core loader inspect the same tree.
function resolvePluginRoot() {
  const direct = resolve(__dirname, "..");
  if (existsSync(join(direct, "core", "dist", "index.js"))) return direct;
  const envRoot = process.env.CLAUDE_PLUGIN_ROOT;
  if (envRoot && existsSync(join(envRoot, "core", "dist", "index.js"))) {
    return envRoot;
  }
  return direct;
}

// Resolve the plugin's own core build. Works whether invoked via `bin/`
// (which is on PATH once the plugin is installed) or via a direct path.
function resolveCorePath() {
  const candidate = join(resolvePluginRoot(), "core", "dist", "index.js");
  return existsSync(candidate) ? candidate : null;
}

function printUsage() {
  process.stdout.write(
    [
      "harness — Claude Code Harness CLI",
      "",
      "Usage:",
      "  harness init                  Create harness.config.json (if missing)",
      "  harness check                 Verify the plugin is installed correctly",
      "  harness doctor                Diagnose local environment",
      "  harness rules list            List active guardrail rules",
      "  harness rules test <cmd>      Dry-run a bash command against R01-R13",
      "  harness model resolve <agent> Print effective Codex model for <agent>",
      "                                  (image-gen / image-edit dispatch to image resolver)",
      "  harness model check [--strict]  Flag deprecated models vs models_cache.json",
      "  harness migrate [--from D]    Migrate legacy .claude/state to v3 JSON",
      "  harness worktree-mux [--multiplexer=cmux|tmux|auto] [--with-claude]",
      "                                  Open git worktrees in cmux/tmux panes",
      "  harness pr-metrics --pr-range <from>..<to>",
      "                                  Collect pull-request review metrics",
      "  harness --version",
      "",
    ].join("\n"),
  );
}

function readVersion() {
  const pkgPath = resolve(__dirname, "..", ".claude-plugin", "plugin.json");
  try {
    const raw = JSON.parse(readFileSync(pkgPath, "utf-8"));
    return raw.version ?? "0.0.0";
  } catch {
    return "unknown";
  }
}

// ------------------------------------------------------------
// Subcommands
// ------------------------------------------------------------

// ------------------------------------------------------------
// Onboarding helpers (template → project bootstrap, dependency probe)
// ------------------------------------------------------------

/**
 * Probe whether `cmd` is on PATH using `which` (POSIX) / `where` (Windows).
 * `execFileSync` exits non-zero when the binary is missing; we swallow that
 * into a boolean so callers stay synchronous.
 */
function commandExists(cmd) {
  try {
    execFileSync(process.platform === "win32" ? "where" : "which", [cmd], {
      stdio: "ignore",
    });
    return true;
  } catch {
    return false;
  }
}

/**
 * Resolve the `template/` directory shipped alongside the plugin.
 * Layout (post-install):
 *   <marketplace>/template/                    ← target
 *   <marketplace>/plugins/harness/bin/harness  ← __dirname
 * `__dirname/../../../template` walks up: bin → harness → plugins → marketplace.
 * Falls back to `CLAUDE_PLUGIN_ROOT/../../template` for hook-invoked CLI runs.
 */
function resolveTemplateRoot() {
  const direct = resolve(__dirname, "..", "..", "..", "template");
  if (existsSync(direct)) return direct;
  const envRoot = process.env.CLAUDE_PLUGIN_ROOT;
  if (envRoot) {
    const candidate = resolve(envRoot, "..", "..", "template");
    if (existsSync(candidate)) return candidate;
  }
  return null;
}

/**
 * Copy a single template file with `{{PLACEHOLDER}}` substitution.
 * Returns true if the destination was written, false if it was preserved
 * (existing destination is never overwritten — `init` is idempotent).
 *
 * `String.prototype.split(literal).join(value)` is regex-meta-character
 * safe — neither `key` nor `value` is interpreted as a regex pattern, so
 * placeholder values containing `[`, `$`, `\`, `.` etc. are inserted verbatim.
 * Switching to `replace(new RegExp(...), value)` would re-introduce the
 * meta-character risk; keep the split/join idiom.
 */
function copyTemplateFile(srcPath, destPath, replacements) {
  if (existsSync(destPath)) return false;
  let content = readFileSync(srcPath, "utf-8");
  for (const [key, value] of Object.entries(replacements)) {
    content = content.split(key).join(value);
  }
  const destDir = dirname(destPath);
  if (!existsSync(destDir)) mkdirSync(destDir, { recursive: true });
  writeFileSync(destPath, content, "utf-8");
  return true;
}

/**
 * Recursively copy a directory tree, applying `replacements` to each file.
 * Skips files that already exist at the destination (idempotent).
 */
function copyTemplateDir(srcDir, destDir, replacements) {
  if (!existsSync(srcDir)) return [];
  if (!existsSync(destDir)) mkdirSync(destDir, { recursive: true });
  const created = [];
  for (const entry of readdirSync(srcDir, { withFileTypes: true })) {
    const src = join(srcDir, entry.name);
    const dest = join(destDir, entry.name);
    if (entry.isDirectory()) {
      created.push(...copyTemplateDir(src, dest, replacements));
    } else if (entry.isFile()) {
      // `.tmpl` 拡張子は配布元の慣習 (template/.coderabbit.yaml.tmpl etc.)。
      // ただし .claude/rules/*.md などは元から `.md` で配布されるので
      // 個別 file の dest 名は呼び出し側で制御する。本 helper は同名 copy のみ。
      if (copyTemplateFile(src, dest, replacements)) {
        created.push(dest);
      }
    }
  }
  return created;
}

function cmdInit(cwdArg) {
  // `CLAUDE_PROJECT_DIR` が設定されていれば cwdArg より優先する。これは
  // resolveTemplateRoot / resolvePluginRoot と同じ env-fallback 規約で、
  // hook-invoked CLI が CLAUDE_PROJECT_DIR をセットするケース (consumer hook /
  // CI runner で cwd と project root が分離する状況) を想定。bootstrap 先を
  // 一元化することで、env と cwd の不整合による silent な誤配置を防ぐ。
  const cwd = process.env.CLAUDE_PROJECT_DIR ?? cwdArg;
  const templateRoot = resolveTemplateRoot();
  const projectName = process.env.CLAUDE_PROJECT_NAME ?? basename(cwd);
  const replacements = {
    "{{PROJECT_NAME}}": projectName,
    "{{PROJECT_DESCRIPTION}}": "(TODO: add description)",
    "{{HARNESS_VERSION}}": readVersion(),
  };

  const created = [];
  const skipped = [];

  // 1) harness.config.json — template があれば placeholder 置換 copy、なければ inline default。
  //    既存動作 (空プロジェクトで harness.config.json のみ生成) を維持しつつ、
  //    template/ を持たない standalone install でも壊れない設計。
  const cfgPath = resolve(cwd, "harness.config.json");
  if (existsSync(cfgPath)) {
    skipped.push("harness.config.json");
  } else {
    const tmplCfg = templateRoot
      ? join(templateRoot, ".claude/harness.config.json.tmpl")
      : null;
    if (tmplCfg && existsSync(tmplCfg)) {
      let content = readFileSync(tmplCfg, "utf-8");
      for (const [key, value] of Object.entries(replacements)) {
        content = content.split(key).join(value);
      }
      writeFileSync(cfgPath, content, "utf-8");
    } else {
      // inline fallback — template が存在しない standalone install 用。
      const starter = {
        projectName,
        language: "en",
        protectedDirectories: [],
        protectedEnvVarNames: [
          "OPENAI_API_KEY",
          "ANTHROPIC_API_KEY",
          "AWS_ACCESS_KEY_ID",
          "AWS_SECRET_ACCESS_KEY",
          "GITHUB_TOKEN",
          "GOOGLE_API_KEY",
        ],
        protectedFileSuffixes: [".env"],
        codex: { enabled: false },
        workMode: { bypassRmRf: false, bypassGitPush: false },
        tampering: { severity: "approve" },
      };
      writeFileSync(cfgPath, JSON.stringify(starter, null, 2) + "\n", "utf-8");
    }
    created.push("harness.config.json");
  }

  // 2) Template 由来の bootstrap files (template root が見つかった時のみ)。
  //    .tmpl 拡張子は dest で剥がす (e.g. CLAUDE.md.tmpl → CLAUDE.md)。
  if (templateRoot) {
    const bootstrap = [
      [".claude/CLAUDE.md.tmpl", "CLAUDE.md"],
      [".claude/settings.local.json.tmpl", ".claude/settings.local.json"],
      ["Plans.md.tmpl", "Plans.md"],
      [".coderabbit.yaml.tmpl", ".coderabbit.yaml"],
      [
        ".github/workflows/harness-check.yml.tmpl",
        ".github/workflows/harness-check.yml",
      ],
    ];
    for (const [srcRel, destRel] of bootstrap) {
      const srcPath = join(templateRoot, srcRel);
      const destPath = resolve(cwd, destRel);
      if (!existsSync(srcPath)) continue;
      if (existsSync(destPath)) {
        skipped.push(destRel);
        continue;
      }
      if (copyTemplateFile(srcPath, destPath, replacements)) {
        created.push(destRel);
      }
    }

    // 3) .claude/rules/ recursive copy (auto-load 対象、複数 .md ファイル)
    const rulesSrc = join(templateRoot, ".claude/rules");
    const rulesDest = resolve(cwd, ".claude/rules");
    if (existsSync(rulesSrc)) {
      const created_ = copyTemplateDir(rulesSrc, rulesDest, replacements);
      for (const f of created_) {
        // dest を project-relative path で記録 (UI 出力の cwd 依存を避ける)
        const rel = f.startsWith(cwd) ? f.slice(cwd.length).replace(/^[\\/]/, "") : f;
        created.push(rel);
      }
    }

    // 4) .gitignore — 既存 .gitignore は touch せず (ユーザー判断に委ねる、merge 衝突回避)
    const giSrc = join(templateRoot, ".gitignore");
    const giDest = resolve(cwd, ".gitignore");
    if (existsSync(giSrc) && !existsSync(giDest)) {
      const content = readFileSync(giSrc, "utf-8");
      writeFileSync(giDest, content, "utf-8");
      created.push(".gitignore");
    } else if (existsSync(giDest)) {
      skipped.push(".gitignore (consider merging template/.gitignore manually)");
    }
  }

  // Output summary
  if (created.length > 0) {
    process.stdout.write(`harness init: created ${created.length} file(s):\n`);
    for (const f of created) process.stdout.write(`  + ${f}\n`);
  }
  if (skipped.length > 0) {
    process.stdout.write(
      `harness init: skipped ${skipped.length} existing file(s) (untouched):\n`,
    );
    for (const f of skipped) process.stdout.write(`  · ${f}\n`);
  }
  if (created.length === 0 && skipped.length === 0) {
    process.stdout.write("harness init: nothing to do.\n");
  }
  return 0;
}

function cmdCheck() {
  const checks = [];
  const corePath = resolveCorePath();
  checks.push(["core build", corePath !== null ? "OK" : "MISSING"]);

  // Use the same root as resolveCorePath so `CLAUDE_PLUGIN_ROOT` switches
  // (e.g. hook-invoked CLI) are honored by the integrity check.
  const pluginRoot = resolvePluginRoot();
  const expected = [
    [".claude-plugin/plugin.json", "manifest"],
    ["hooks/hooks.json", "hook registration"],
    ["scripts/hook-dispatcher.mjs", "dispatcher"],
    ["agents/worker.md", "worker agent"],
    ["agents/reviewer.md", "reviewer agent"],
    ["agents/scaffolder.md", "scaffolder agent"],
    ["agents/codex-sync.md", "codex-sync agent"],
    ["agents/coderabbit-mimic.md", "coderabbit-mimic agent"],
    ["agents/security-auditor.md", "security-auditor agent"],
    ["commands/harness-plan.md", "plan command"],
    ["commands/harness-work.md", "work command"],
    ["commands/harness-review.md", "review command"],
    ["commands/harness-release.md", "release command"],
    ["commands/harness-setup.md", "setup command"],
    ["commands/branch-merge.md", "branch-merge command"],
    ["commands/new-feature-branch.md", "new-feature-branch command"],
    ["commands/coderabbit-review.md", "coderabbit-review command"],
    ["commands/codex-team.md", "codex-team command"],
    ["commands/parallel-worktree.md", "parallel-worktree command"],
    ["commands/pseudo-coderabbit-loop.md", "pseudo-coderabbit-loop command"],
    ["commands/tdd-implement.md", "tdd-implement command"],
  ];
  for (const [rel, label] of expected) {
    const path = join(pluginRoot, rel);
    checks.push([label, existsSync(path) ? "OK" : `MISSING: ${rel}`]);
  }

  let ok = true;
  process.stdout.write("Plugin integrity:\n");
  for (const [label, status] of checks) {
    process.stdout.write(`  ${label.padEnd(24)} ${status}\n`);
    if (status !== "OK") ok = false;
  }

  // ----------------------------------------------------------------------
  // Project state recommendations (warnings, non-blocking).
  // Plugin integrity (above) は exit code に反映、project state は
  // info / warning として表示するのみ — consumer の onboarding 漏れを
  // 検出するが、CI を失敗させない (consumer 自由度を尊重)。
  // ----------------------------------------------------------------------
  const projectChecks = [];
  const projectDir = process.env.CLAUDE_PROJECT_DIR ?? process.cwd();

  // .coderabbit.yaml + request_changes_workflow: true (APPROVED 自動発火の前提)
  const yamlPath = join(projectDir, ".coderabbit.yaml");
  if (!existsSync(yamlPath)) {
    projectChecks.push([
      ".coderabbit.yaml",
      "WARN: not found — copy from template/.coderabbit.yaml.tmpl to enable APPROVED auto-fire",
    ]);
  } else {
    try {
      const raw = readFileSync(yamlPath, "utf-8");
      // 軽量判定 (CLI で yaml lib をロードしない方針)。
      // false-positive 防止: YAML comment 行 (`#` で始まる) は事前に除去してから
      // 判定する。例えば `# request_changes_workflow: true (legacy doc)` の
      // ような文書化目的のコメント行を実値として誤検出しない。structural 検証は
      // content-integrity.test.ts (vitest 側、yaml lib 使用) で別途実施。
      const stripped = raw
        .split(/\r?\n/)
        .filter((line) => !line.trim().startsWith("#"))
        .join("\n");
      if (/^\s*request_changes_workflow\s*:\s*true\b/m.test(stripped)) {
        projectChecks.push([".coderabbit.yaml", "OK"]);
      } else {
        projectChecks.push([
          ".coderabbit.yaml",
          "WARN: request_changes_workflow: true not found — APPROVED state may not auto-fire",
        ]);
      }
    } catch (e) {
      projectChecks.push([
        ".coderabbit.yaml",
        `WARN: read failed (${e instanceof Error ? e.message : String(e)})`,
      ]);
    }
  }

  // External CLI 依存 — どれも consumer-facing で、不在は工程によっては blocker だが
  // harness 自体は動く (個別 skill が gracefully degrade)。
  const externalDeps = [
    ["gh", "GitHub CLI — required for /coderabbit-review, gh pr ops"],
    ["codex", "Codex CLI — required for codex-sync / coderabbit-mimic agents"],
    ["coderabbit", "CodeRabbit CLI — required for /pseudo-coderabbit-loop real-CR mode"],
  ];
  for (const [bin, desc] of externalDeps) {
    if (commandExists(bin)) {
      projectChecks.push([bin, "OK"]);
    } else {
      projectChecks.push([bin, `WARN: not on PATH (${desc})`]);
    }
  }

  process.stdout.write("\nProject state (recommendations, non-blocking):\n");
  for (const [label, status] of projectChecks) {
    process.stdout.write(`  ${label.padEnd(24)} ${status}\n`);
  }

  return ok ? 0 : 1;
}

async function cmdDoctor() {
  const out = [];
  out.push(`harness version:     ${readVersion()}`);
  out.push(`node version:        ${process.version}`);
  out.push(`platform:            ${process.platform}/${process.arch}`);
  out.push(`CLAUDE_PLUGIN_ROOT:  ${process.env.CLAUDE_PLUGIN_ROOT ?? "(unset)"}`);
  out.push(`CLAUDE_PROJECT_DIR:  ${process.env.CLAUDE_PROJECT_DIR ?? "(unset)"}`);
  out.push(`cwd:                 ${process.cwd()}`);
  const corePath = resolveCorePath();
  out.push(`core build:          ${corePath ?? "NOT FOUND"}`);
  if (corePath !== null) {
    try {
      const stat = statSync(corePath);
      out.push(`core build mtime:    ${stat.mtime.toISOString()}`);
    } catch {
      // ignore
    }
  }

  // codex-sync truncate mitigation thresholds (codex.sync.*). Defaults
  // mirror `DEFAULT_CONFIG.codex.sync` in core/src/config.ts. Both the
  // harness.config.json loader and the TASK_MAX_OUTPUT_LENGTH report
  // below override these when the user supplies them; keeping the
  // defaults in sync with config.ts is enforced by unit tests.
  let codexSyncCheck = true;
  let codexSyncWarnBelow = 32000;
  let codexSyncRecommended = 160000;

  // Codex companion (optional — used by codex-sync / coderabbit-mimic agents).
  // `os.homedir()` handles Windows (USERPROFILE) + POSIX HOME + edge
  // cases where HOME is unset in container / CI environments. Falling
  // back to `process.env.HOME ?? ""` previously caused `path.join("", …)`
  // to resolve relative to cwd, producing false "codex not installed" /
  // false user-overlay readings on Windows.
  const home = homedir();
  const codexDir = join(home, ".claude", "plugins", "cache", "openai-codex", "codex");
  if (existsSync(codexDir)) {
    out.push(`codex plugin:        detected at ${codexDir}`);
  } else {
    // Hint uses a fully-qualified `claude plugin install` command so the user
    // can copy-paste from any directory; `install-project.sh` would be a
    // relative path that doesn't exist in the user's project root.
    out.push(`codex plugin:        not installed (optional — install with 'claude plugin install codex@openai-codex --scope project' to enable codex-sync / coderabbit-mimic)`);
  }

  // Project-local overrides / overlays.
  const projectDir = process.env.CLAUDE_PROJECT_DIR ?? process.cwd();
  const harnessConfigPath = join(projectDir, "harness.config.json");
  if (existsSync(harnessConfigPath)) {
    out.push(`harness.config.json: ${harnessConfigPath}`);
    try {
      const cfg = JSON.parse(readFileSync(harnessConfigPath, "utf-8"));
      const checklistPath = cfg?.security?.projectChecklistPath;
      if (typeof checklistPath === "string" && checklistPath.length > 0) {
        const resolvedChecklist = resolve(projectDir, checklistPath);
        if (existsSync(resolvedChecklist)) {
          out.push(`project security checklist: ${resolvedChecklist}`);
        } else {
          out.push(`project security checklist: MISSING (${checklistPath} from harness.config.json does not resolve)`);
        }
      }
      const plansFile = cfg?.work?.plansFile;
      if (typeof plansFile === "string" && plansFile.length > 0) {
        const plansPath = resolve(projectDir, plansFile);
        out.push(`plans file:          ${plansPath}${existsSync(plansPath) ? "" : " (missing)"}`);
      }
      const handoffFiles = Array.isArray(cfg?.work?.handoffFiles) ? cfg.work.handoffFiles : [];
      for (let i = 0; i < handoffFiles.length; i++) {
        const rel = handoffFiles[i];
        if (typeof rel !== "string") {
          // Warn so misconfigurations (null / number / object entries) stay
          // visible instead of being silently dropped from the report.
          out.push(
            `handoff file:        WARN entry [${i}] is not a string (got ${typeof rel}): ${JSON.stringify(rel)}`,
          );
          continue;
        }
        if (rel.length === 0) {
          out.push(`handoff file:        WARN entry [${i}] is an empty string`);
          continue;
        }
        const p = resolve(projectDir, rel);
        out.push(`handoff file:        ${p}${existsSync(p) ? "" : " (missing — optional)"}`);
      }
      // codex-sync truncate mitigation: project override of codex.sync.*.
      // Accept only well-typed scalars AND values that fall within the
      // JSON schema's declared bounds — malformed entries (string, null,
      // NaN, Infinity, non-integer, out-of-range) fall through to the
      // shipped defaults rather than poisoning the doctor report. Range
      // bounds mirror `harness.config.schema.json`:
      //   - `recommendedTaskMaxOutputLength`: integer, [32000, 160000]
      //     (Claude Code's documented range — outside values would
      //     advertise something the runtime silently clamps).
      //   - `warnTaskMaxOutputLengthBelow`: integer, [1, 160000].
      // Out-of-range values are logged via stderr so CI catches the
      // drift instead of silently falling back.
      const syncCfg = cfg?.codex?.sync;
      const isIntInRange = (v, min, max) =>
        typeof v === "number" && Number.isInteger(v) && v >= min && v <= max;
      if (syncCfg && typeof syncCfg === "object") {
        if (typeof syncCfg.checkTaskMaxOutputLength === "boolean") {
          codexSyncCheck = syncCfg.checkTaskMaxOutputLength;
        }
        if (syncCfg.warnTaskMaxOutputLengthBelow !== undefined) {
          if (isIntInRange(syncCfg.warnTaskMaxOutputLengthBelow, 1, 160000)) {
            codexSyncWarnBelow = syncCfg.warnTaskMaxOutputLengthBelow;
          } else {
            process.stderr.write(
              `harness doctor: ignoring out-of-range codex.sync.warnTaskMaxOutputLengthBelow=${JSON.stringify(syncCfg.warnTaskMaxOutputLengthBelow)} (expected integer in [1, 160000]); using default ${codexSyncWarnBelow}\n`,
            );
          }
        }
        if (syncCfg.recommendedTaskMaxOutputLength !== undefined) {
          if (isIntInRange(syncCfg.recommendedTaskMaxOutputLength, 32000, 160000)) {
            codexSyncRecommended = syncCfg.recommendedTaskMaxOutputLength;
          } else {
            process.stderr.write(
              `harness doctor: ignoring out-of-range codex.sync.recommendedTaskMaxOutputLength=${JSON.stringify(syncCfg.recommendedTaskMaxOutputLength)} (expected integer in [32000, 160000]); using default ${codexSyncRecommended}\n`,
            );
          }
        }
        // Cross-field invariant: `recommendedTaskMaxOutputLength` must be
        // at least `warnTaskMaxOutputLengthBelow`, otherwise the doctor
        // would recommend a value that is *itself* below the threshold
        // it uses to decide WARN — a confused state where the operator
        // is told "set to X" and the doctor would immediately re-flag
        // X as "below threshold". Schema can't easily express an
        // allOf cross-field bound in draft-07, so enforce at load
        // time: warn via stderr and clamp `recommended` up to
        // `warnBelow`. The warn threshold is the load-bearing signal
        // (doctor's WARN decision hinges on it), so preserving it and
        // raising `recommended` beats lowering the threshold to match
        // a malformed `recommended`.
        if (codexSyncRecommended < codexSyncWarnBelow) {
          process.stderr.write(
            `harness doctor: codex.sync.recommendedTaskMaxOutputLength (${codexSyncRecommended}) is below warnTaskMaxOutputLengthBelow (${codexSyncWarnBelow}); clamping recommended up to ${codexSyncWarnBelow} to avoid a self-contradictory recommendation\n`,
          );
          codexSyncRecommended = codexSyncWarnBelow;
        }
      }
    } catch (err) {
      out.push(`harness.config.json: PARSE ERROR (${err instanceof Error ? err.message : String(err)})`);
    }
  } else {
    out.push(`harness.config.json: not found at ${harnessConfigPath} (run 'harness init' to create one)`);
  }

  // codex-sync truncate mitigation: report the effective
  // TASK_MAX_OUTPUT_LENGTH env var so operators spot an unset or low
  // value before the next codex-sync mid-truncation.
  // Claude Code runtime caps subagent final responses at the env var's
  // value (default 32000, runtime-observed cap at 160000); raising it lets
  // codex-sync return multi-KB review output without resume dances.
  // Respects `codex.sync.checkTaskMaxOutputLength: false` for CI.
  if (codexSyncCheck) {
    const taskMaxRaw = process.env.TASK_MAX_OUTPUT_LENGTH;
    if (taskMaxRaw !== undefined && taskMaxRaw.length > 0) {
      const taskMax = Number(taskMaxRaw);
      if (Number.isFinite(taskMax) && taskMax > 0) {
        if (taskMax < codexSyncWarnBelow) {
          out.push(
            `TASK_MAX_OUTPUT_LENGTH: ${taskMax} (WARN below ${codexSyncWarnBelow} — recommend 'export TASK_MAX_OUTPUT_LENGTH=${codexSyncRecommended}' to avoid codex-sync mid-truncation; Claude Code silently clamps values above 160000)`,
          );
        } else if (taskMax > 160000) {
          // Over the runtime-observed cap — Claude Code silently
          // clamps the effective limit to 160000 (the upper bound
          // surfaced by its env-vars reference), so reporting "OK"
          // here would mislead the operator. Flag explicitly so they
          // know the env var value is not honoured as-is.
          out.push(
            `TASK_MAX_OUTPUT_LENGTH: ${taskMax} (WARN above the runtime-observed cap of 160000 — Claude Code silently clamps higher values; consider 'export TASK_MAX_OUTPUT_LENGTH=160000' for parity)`,
          );
        } else {
          out.push(`TASK_MAX_OUTPUT_LENGTH: ${taskMax} (OK)`);
        }
      } else {
        out.push(
          `TASK_MAX_OUTPUT_LENGTH: "${taskMaxRaw}" (WARN unparseable — recommend 'export TASK_MAX_OUTPUT_LENGTH=${codexSyncRecommended}')`,
        );
      }
    } else {
      out.push(
        `TASK_MAX_OUTPUT_LENGTH: unset — Claude Code falls back to runtime default 32000. Recommend 'export TASK_MAX_OUTPUT_LENGTH=${codexSyncRecommended}' to avoid codex-sync mid-truncation.`,
      );
    }
  }

  // Project-local skill scaffold (harness plugin's project-local convention).
  const localSkillDir = join(projectDir, ".claude", "skills");
  if (existsSync(localSkillDir)) {
    out.push(`project skill dir:   ${localSkillDir}`);
  } else {
    out.push(`project skill dir:   none (optional — see CONTRIBUTING.md §5 test-bed policy)`);
  }

  // User-scope overlay (identifies plugin is running with user-level skills available).
  const userClaudeDir = join(home, ".claude");
  const userSkills = join(userClaudeDir, "skills");
  const userCommands = join(userClaudeDir, "commands");
  const userAgents = join(userClaudeDir, "agents");
  out.push(
    `user overlays:       skills=${existsSync(userSkills) ? "yes" : "no"}, commands=${existsSync(userCommands) ? "yes" : "no"}, agents=${existsSync(userAgents) ? "yes" : "no"}`,
  );

  process.stdout.write(out.join("\n") + "\n");
  return 0;
}

async function cmdRulesList() {
  const corePath = resolveCorePath();
  if (corePath === null) {
    process.stderr.write("harness rules list: core build not found. Run `npm run build`.\n");
    return 1;
  }
  const rulesPath = corePath.replace("index.js", "guardrails/rules.js");
  const rulesMod = await import(`file://${rulesPath.replace(/\\/g, "/")}`);
  for (const rule of rulesMod.GUARD_RULES) {
    process.stdout.write(`  ${rule.id.padEnd(36)} tool=${rule.toolPattern}\n`);
  }
  return 0;
}

async function cmdRulesTest(command) {
  if (!command) {
    process.stderr.write("usage: harness rules test <bash-command>\n");
    return 2;
  }
  const corePath = resolveCorePath();
  if (corePath === null) {
    process.stderr.write("harness rules test: core build not found.\n");
    return 1;
  }
  const preToolPath = corePath.replace("index.js", "guardrails/pre-tool.js");
  const mod = await import(`file://${preToolPath.replace(/\\/g, "/")}`);
  const result = mod.evaluatePreTool({
    tool_name: "Bash",
    tool_input: { command },
    cwd: process.cwd(),
  });
  process.stdout.write(JSON.stringify(result, null, 2) + "\n");
  return 0;
}

// ------------------------------------------------------------
// harness model resolve / harness model check
// ------------------------------------------------------------

async function loadResolverModule() {
  const corePath = resolveCorePath();
  if (corePath === null) return null;
  const resolverPath = corePath.replace(
    "index.js",
    "models/resolver.js",
  );
  if (!existsSync(resolverPath)) return null;
  return await import(`file://${resolverPath.replace(/\\/g, "/")}`);
}

async function loadProjectModelsConfig() {
  const corePath = resolveCorePath();
  if (corePath === null) return undefined;
  const configPath = corePath.replace("index.js", "config.js");
  const mod = await import(`file://${configPath.replace(/\\/g, "/")}`);
  const projectDir = process.env.CLAUDE_PROJECT_DIR ?? process.cwd();
  const cfg = mod.loadConfigSafe
    ? mod.loadConfigSafe(projectDir)
    : mod.loadConfig(projectDir);
  return cfg?.models;
}

/**
 * Load the project's full image-generation surface (`imageGeneration` +
 * `models` for the shared alias map / per-agent override). Returns
 * `{ imageGeneration: undefined, models: undefined }` when the core
 * build is missing **or** the project has no `harness.config.json`.
 *
 * The "no config file" case is critical for the CLI: without this
 * check, `loadConfigSafe` would synthesise `DEFAULT_CONFIG.imageGeneration`
 * and the resolver would emit `source: "image-default"` for an
 * unconfigured project — masking the distinction between shipped
 * behaviour and explicit user intent. Returning undefined makes
 * `harness model resolve image-gen` correctly emit
 * `source: "harness-default"` until the user pins something.
 */
async function loadProjectImageGenerationConfig() {
  const corePath = resolveCorePath();
  if (corePath === null) return { imageGeneration: undefined, models: undefined };
  const projectDir = process.env.CLAUDE_PROJECT_DIR ?? process.cwd();
  const userConfigPath = resolve(projectDir, "harness.config.json");
  if (!existsSync(userConfigPath)) {
    return { imageGeneration: undefined, models: undefined };
  }
  const configPath = corePath.replace("index.js", "config.js");
  const mod = await import(`file://${configPath.replace(/\\/g, "/")}`);
  const cfg = mod.loadConfigSafe
    ? mod.loadConfigSafe(projectDir)
    : mod.loadConfig(projectDir);
  return {
    imageGeneration: cfg?.imageGeneration,
    models: cfg?.models,
  };
}

// Reserved agent names that route to `resolveImageModel` instead of the
// text-side `resolveModel`. Keep this list small and explicit so a
// project cannot rebind a text agent to the image resolver by naming
// collision (would silently flip the source enum from "agent-override"
// to "image-default").
const IMAGE_AGENT_NAMES = new Set(["image-gen", "image-edit"]);

function loadCodexModelsCache() {
  const home = homedir();
  const cachePath = join(home, ".codex", "models_cache.json");
  if (!existsSync(cachePath)) return null;
  try {
    const raw = JSON.parse(readFileSync(cachePath, "utf-8"));
    const configPath = join(home, ".codex", "config.toml");
    const migrations = {};
    if (existsSync(configPath)) {
      // Normalise CRLF / CR to LF before regex matching so Windows line
      // endings inside the user's config.toml do not leak stray `\r` into
      // migration keys / values. The section is small (kv pairs) so a
      // dedicated TOML parser would be overkill.
      const toml = readFileSync(configPath, "utf-8").replace(/\r\n?/g, "\n");
      // Parse the [notice.model_migrations] block without a TOML lib; the
      // section is small (kv pairs) and we only need string → string.
      const blockMatch = toml.match(
        /\[notice\.model_migrations\]\s*([\s\S]*?)(?=\n\[|$)/,
      );
      if (blockMatch) {
        const body = blockMatch[1];
        const lineRe = /"([^"]+)"\s*=\s*"([^"]+)"/g;
        let m;
        while ((m = lineRe.exec(body)) !== null) {
          migrations[m[1]] = m[2];
        }
      }
    }
    return {
      models: raw.models,
      upgrade: raw.upgrade,
      migrations,
    };
  } catch (err) {
    process.stderr.write(
      `harness model check: failed to read models cache (${
        err instanceof Error ? err.message : String(err)
      })\n`,
    );
    return null;
  }
}

async function cmdModelResolve(agent) {
  if (!agent) {
    process.stderr.write("usage: harness model resolve <agent>\n");
    return 2;
  }
  const mod = await loadResolverModule();
  if (!mod) {
    process.stderr.write(
      "harness model resolve: core build not found. Run `npm run build`.\n",
    );
    return 1;
  }
  // Dispatch image agents to `resolveImageModel` so `image-gen` /
  // `image-edit` honour the `imageGeneration.*` config surface and the
  // image-side compile-time defaults (image_gen tool dependency).
  const normalized =
    typeof mod.normalizeAgentName === "function"
      ? mod.normalizeAgentName(agent)
      : String(agent ?? "").trim();
  if (IMAGE_AGENT_NAMES.has(normalized)) {
    const { imageGeneration, models } = await loadProjectImageGenerationConfig();
    const resolution = mod.resolveImageModel(imageGeneration, models, agent);
    process.stdout.write(JSON.stringify(resolution, null, 2) + "\n");
    return 0;
  }
  const config = await loadProjectModelsConfig();
  const resolution = mod.resolveModel(config, agent);
  process.stdout.write(JSON.stringify(resolution, null, 2) + "\n");
  return 0;
}

async function cmdModelCheck(strict) {
  const mod = await loadResolverModule();
  if (!mod) {
    process.stderr.write(
      "harness model check: core build not found. Run `npm run build`.\n",
    );
    return 1;
  }
  const config = await loadProjectModelsConfig();
  const cache = loadCodexModelsCache();
  const report = mod.checkModels(config, cache);
  process.stdout.write(JSON.stringify(report, null, 2) + "\n");
  if (strict && report.hits.length > 0) return 1;
  return 0;
}

async function cmdMigrate(fromDir) {
  const corePath = resolveCorePath();
  if (corePath === null) {
    process.stderr.write("harness migrate: core build not found.\n");
    return 1;
  }
  const migPath = corePath.replace("index.js", "state/migration.js");
  const mod = await import(`file://${migPath.replace(/\\/g, "/")}`);
  const target = fromDir ? resolve(fromDir) : process.cwd();
  const result = mod.migrate(target);
  process.stdout.write(JSON.stringify(result, null, 2) + "\n");
  return result.errors.length > 0 ? 1 : 0;
}

function parseWorktreeMuxArgs(rest) {
  const VALID_MUX = new Set(["cmux", "tmux", "auto"]);
  let multiplexer = "auto";
  let withClaude = false;
  for (let i = 0; i < rest.length; i++) {
    const arg = rest[i];
    if (arg === "--with-claude") {
      withClaude = true;
      continue;
    }
    // Accept the equals form (--multiplexer=cmux).
    if (arg.startsWith("--multiplexer=")) {
      const value = arg.slice("--multiplexer=".length);
      if (!VALID_MUX.has(value)) {
        process.stderr.write(
          `harness worktree-mux: --multiplexer expects cmux|tmux|auto (got '${value}')\n`,
        );
        return { error: 2 };
      }
      multiplexer = value;
      continue;
    }
    // Also accept the space-separated form (--multiplexer cmux) for
    // consistency with other CLIs (gh, git, etc.).
    if (arg === "--multiplexer") {
      const value = rest[i + 1];
      if (!value || !VALID_MUX.has(value)) {
        process.stderr.write(
          `harness worktree-mux: --multiplexer expects cmux|tmux|auto (got '${value ?? "<missing>"}')\n`,
        );
        return { error: 2 };
      }
      multiplexer = value;
      i++;
      continue;
    }
    if (arg === "--help" || arg === "-h") {
      return { help: true };
    }
    process.stderr.write(`harness worktree-mux: unknown flag '${arg}'\n`);
    return { error: 2 };
  }
  return { multiplexer, withClaude };
}

async function cmdWorktreeMux(rest) {
  const args = parseWorktreeMuxArgs(rest);
  if (args.help) {
    process.stdout.write(
      [
        "harness worktree-mux [--multiplexer=cmux|tmux|auto] [--with-claude]",
        "",
        "  --multiplexer=auto  (default) Pick cmux first, fall back to tmux,",
        "                                then to a text listing.",
        "  --multiplexer=cmux            Require cmux. Errors if missing.",
        "  --multiplexer=tmux            Require tmux. Errors if missing.",
        "  --with-claude                 Launch `claude` in each pane.",
        "",
        "Environment:",
        "  CMUX_CMD_TEMPLATE  Override the cmux invocation (default:",
        "                     `cmux open --column {path}`). `{path}` is replaced",
        "                     by the worktree path.",
        "",
      ].join("\n"),
    );
    return 0;
  }
  if (args.error !== undefined) return args.error;

  const corePath = resolveCorePath();
  if (corePath === null) {
    process.stderr.write(
      "harness worktree-mux: core build not found. Run `npm run build`.\n",
    );
    return 1;
  }
  const muxPath = corePath.replace("index.js", "worktree-mux.js");
  const mod = await import(`file://${muxPath.replace(/\\/g, "/")}`);
  const plan = mod.planWorktreeMux({
    multiplexer: args.multiplexer,
    withClaude: args.withClaude,
    cmuxCommandTemplate: process.env.CMUX_CMD_TEMPLATE,
  });
  return mod.runPlan(plan);
}

// ------------------------------------------------------------
// harness pr-metrics
// ------------------------------------------------------------

function printPrMetricsUsage(stream = process.stderr) {
  stream.write(
    [
      "usage: harness pr-metrics --pr-range <from>..<to> [--repo owner/name]",
      "       [--input PATH] [--manual-metrics PATH] [--output-json PATH] [--output-md PATH]",
      "",
      "Collect PR review metrics from GitHub PR metadata.",
      "Use --input for an offline fixture with { repository, prs }.",
      "Use --manual-metrics for GitHub-invisible values keyed by PR number.",
      "",
    ].join("\n"),
  );
}

function parsePrMetricsArgs(rest) {
  const args = {
    prRange: undefined,
    input: undefined,
    manualMetrics: undefined,
    outputJson: undefined,
    outputMd: undefined,
    repo: undefined,
    help: false,
  };
  for (let i = 0; i < rest.length; i++) {
    const arg = rest[i];
    if (arg === "--help" || arg === "-h") {
      args.help = true;
      continue;
    }
    const readValue = (flag) => {
      const value = rest[i + 1];
      if (!value || value.startsWith("--")) {
        throw new Error(`${flag} expects a value`);
      }
      i++;
      return value;
    };
    if (arg === "--pr-range") {
      args.prRange = readValue(arg);
      continue;
    }
    if (arg.startsWith("--pr-range=")) {
      args.prRange = arg.slice("--pr-range=".length);
      continue;
    }
    if (arg === "--input") {
      args.input = readValue(arg);
      continue;
    }
    if (arg.startsWith("--input=")) {
      args.input = arg.slice("--input=".length);
      continue;
    }
    if (arg === "--manual-metrics") {
      args.manualMetrics = readValue(arg);
      continue;
    }
    if (arg.startsWith("--manual-metrics=")) {
      args.manualMetrics = arg.slice("--manual-metrics=".length);
      continue;
    }
    if (arg === "--output-json") {
      args.outputJson = readValue(arg);
      continue;
    }
    if (arg.startsWith("--output-json=")) {
      args.outputJson = arg.slice("--output-json=".length);
      continue;
    }
    if (arg === "--output-md") {
      args.outputMd = readValue(arg);
      continue;
    }
    if (arg.startsWith("--output-md=")) {
      args.outputMd = arg.slice("--output-md=".length);
      continue;
    }
    if (arg === "--repo") {
      args.repo = readValue(arg);
      continue;
    }
    if (arg.startsWith("--repo=")) {
      args.repo = arg.slice("--repo=".length);
      continue;
    }
    throw new Error(`unknown flag '${arg}'`);
  }
  return args;
}

function parsePrRange(prRange) {
  const match = String(prRange ?? "").trim().match(/^(\d+)\.\.(\d+)$/);
  if (!match) {
    throw new Error("--pr-range expects '<from>..<to>' with numeric PR numbers");
  }
  const from = Number(match[1]);
  const to = Number(match[2]);
  if (!Number.isInteger(from) || !Number.isInteger(to) || from <= 0 || to <= 0 || from > to) {
    throw new Error("--pr-range expects '<from>..<to>' where from <= to");
  }
  return { from, to, numbers: Array.from({ length: to - from + 1 }, (_, idx) => from + idx) };
}

function resolvePrMetricsNow() {
  const raw = process.env.HARNESS_PR_METRICS_NOW;
  if (!raw) return new Date();
  const parsed = new Date(raw);
  if (Number.isNaN(parsed.getTime())) return new Date();
  return parsed;
}

function readPrMetricsInput(inputPath) {
  const raw = JSON.parse(readFileSync(resolve(inputPath), "utf-8"));
  if (Array.isArray(raw)) return { repository: undefined, prs: raw };
  if (!raw || !Array.isArray(raw.prs)) {
    throw new Error("--input must be a JSON array or an object with a prs array");
  }
  return { repository: raw.repository, prs: raw.prs };
}

const MANUAL_METRIC_KEYS = [
  "api_token_cost",
  "independent_review_rework_rounds",
  "post_merge_hotfixes_7d",
  "operator_load",
];

function emptyManualMetrics() {
  return {
    api_token_cost: null,
    independent_review_rework_rounds: null,
    post_merge_hotfixes_7d: null,
    operator_load: null,
  };
}

function normalizeManualMetricValue(value, sourceLabel, key) {
  if (value === undefined) return undefined;
  if (value === null) return null;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new Error(`--manual-metrics ${sourceLabel}.${key} must be finite`);
    }
    return value;
  }
  if (typeof value === "string") {
    const trimmed = value.trim();
    return trimmed === "" ? null : trimmed;
  }
  throw new Error(`--manual-metrics ${sourceLabel}.${key} must be a number, string, or null`);
}

function normalizeManualMetricsRecord(record, sourceLabel) {
  if (!record || typeof record !== "object" || Array.isArray(record)) {
    throw new Error(`--manual-metrics ${sourceLabel} must be an object`);
  }
  const metrics = {};
  for (const key of MANUAL_METRIC_KEYS) {
    if (!Object.prototype.hasOwnProperty.call(record, key)) continue;
    const value = normalizeManualMetricValue(record[key], sourceLabel, key);
    if (value !== undefined) metrics[key] = value;
  }
  return metrics;
}

function readManualMetricsInput(inputPath) {
  const raw = JSON.parse(readFileSync(resolve(inputPath), "utf-8"));
  const byPrNumber = new Map();
  const addRecord = (numberValue, record, sourceLabel) => {
    const number = Number(numberValue);
    if (!Number.isInteger(number) || number <= 0) {
      throw new Error(`--manual-metrics ${sourceLabel} must identify a positive PR number`);
    }
    if (byPrNumber.has(number)) {
      throw new Error(`--manual-metrics has duplicate data for PR #${number}`);
    }
    byPrNumber.set(number, normalizeManualMetricsRecord(record, sourceLabel));
  };

  if (Array.isArray(raw)) {
    raw.forEach((entry, index) => {
      const number = entry?.number ?? entry?.pr ?? entry?.pr_number;
      addRecord(number, entry, `entry[${index}]`);
    });
    return byPrNumber;
  }
  if (raw && typeof raw === "object" && Array.isArray(raw.prs)) {
    raw.prs.forEach((entry, index) => {
      const number = entry?.number ?? entry?.pr ?? entry?.pr_number;
      addRecord(number, entry, `prs[${index}]`);
    });
    return byPrNumber;
  }
  if (raw && typeof raw === "object") {
    for (const [number, record] of Object.entries(raw)) {
      addRecord(number, record, `PR #${number}`);
    }
    return byPrNumber;
  }
  throw new Error("--manual-metrics must be a JSON object, array, or object with a prs array");
}

function runGhJson(args) {
  const out = execFileSync("gh", args, {
    encoding: "utf-8",
    stdio: ["ignore", "pipe", "pipe"],
  });
  return JSON.parse(out);
}

function resolvePrMetricsRepo(explicitRepo) {
  if (explicitRepo) return explicitRepo;
  const result = runGhJson(["repo", "view", "--json", "nameWithOwner"]);
  return result.nameWithOwner;
}

function collectPrMetricsPrsFromGh(numbers, repo) {
  if (!commandExists("gh")) {
    throw new Error("gh CLI is required unless --input is provided");
  }
  const fields = [
    "number",
    "title",
    "url",
    "state",
    "createdAt",
    "mergedAt",
    "closedAt",
    "headRefName",
    "baseRefName",
    "author",
    "reviews",
    "comments",
  ].join(",");
  const prs = [];
  const missing = [];
  for (const number of numbers) {
    try {
      prs.push(
        runGhJson([
          "pr",
          "view",
          String(number),
          "--json",
          fields,
          ...(repo ? ["--repo", repo] : []),
        ]),
      );
    } catch {
      missing.push(number);
    }
  }
  if (missing.length > 0) {
    throw new Error(
      `missing PR data for requested range: ${missing
        .map((number) => `#${number}`)
        .join(", ")}`,
    );
  }
  return prs;
}

function asDate(value) {
  if (!value) return null;
  const parsed = new Date(value);
  return Number.isNaN(parsed.getTime()) ? null : parsed;
}

function round2(value) {
  if (value === null || value === undefined || !Number.isFinite(value)) return null;
  return Math.round(value * 100) / 100;
}

function hoursBetween(startValue, endValue) {
  const start = asDate(startValue);
  const end = asDate(endValue);
  if (!start || !end || end.getTime() < start.getTime()) return null;
  return round2((end.getTime() - start.getTime()) / 3_600_000);
}

function median(values) {
  const finite = values.filter((value) => Number.isFinite(value)).sort((a, b) => a - b);
  if (finite.length === 0) return null;
  const mid = Math.floor(finite.length / 2);
  if (finite.length % 2 === 1) return round2(finite[mid]);
  return round2((finite[mid - 1] + finite[mid]) / 2);
}

function isCoderabbitActor(actor) {
  const login = String(actor?.login ?? actor ?? "").toLowerCase();
  return login === "coderabbitai" || login === "coderabbitai[bot]" || login.startsWith("coderabbitai-");
}

function normalizeReview(review) {
  const state = String(review?.state ?? "").toUpperCase();
  const author = review?.author ?? review?.user ?? review?.actor;
  return { state, author };
}

function normalizePrMetricsPr(pr, manualMetricsByNumber = new Map()) {
  const reviews = Array.isArray(pr?.reviews) ? pr.reviews.map(normalizeReview) : [];
  const coderabbitReviews = reviews.filter((review) => isCoderabbitActor(review.author));
  const coderabbitChangeRequests = coderabbitReviews.filter(
    (review) => review.state === "CHANGES_REQUESTED",
  ).length;
  const coderabbitApprovals = coderabbitReviews.filter(
    (review) => review.state === "APPROVED",
  ).length;
  const wallclockHours = hoursBetween(pr?.createdAt, pr?.mergedAt ?? pr?.closedAt);
  const number = Number(pr?.number);
  const manualMetrics = manualMetricsByNumber.get(number) ?? {};
  return {
    number,
    title: String(pr?.title ?? ""),
    url: String(pr?.url ?? ""),
    state: String(pr?.state ?? "").toUpperCase(),
    created_at: pr?.createdAt ?? null,
    merged_at: pr?.mergedAt ?? null,
    closed_at: pr?.closedAt ?? null,
    head_ref: pr?.headRefName ?? null,
    base_ref: pr?.baseRefName ?? null,
    wallclock_hours: wallclockHours,
    coderabbit_reviews: coderabbitReviews.length,
    coderabbit_change_requests: coderabbitChangeRequests,
    coderabbit_approvals: coderabbitApprovals,
    total_reviews: reviews.length,
    total_comments: Array.isArray(pr?.comments) ? pr.comments.length : null,
    manual_metrics: { ...emptyManualMetrics(), ...manualMetrics },
  };
}

function summarizePrMetrics(prs) {
  const wallclock = prs
    .map((pr) => pr.wallclock_hours)
    .filter((value) => Number.isFinite(value));
  return {
    pr_count: prs.length,
    merged_pr_count: prs.filter((pr) => pr.state === "MERGED").length,
    wallclock_hours_median: median(wallclock),
    wallclock_hours_max: wallclock.length > 0 ? round2(Math.max(...wallclock)) : null,
    coderabbit_reviews_total: prs.reduce((sum, pr) => sum + pr.coderabbit_reviews, 0),
    coderabbit_change_requests_total: prs.reduce(
      (sum, pr) => sum + pr.coderabbit_change_requests,
      0,
    ),
    coderabbit_approvals_total: prs.reduce((sum, pr) => sum + pr.coderabbit_approvals, 0),
  };
}

function filterPrMetricsPrsByRange(prs, numbers) {
  const allowed = new Set(numbers);
  return prs.filter((pr) => allowed.has(Number(pr?.number)));
}

function findMissingPrMetricsPrNumbers(prs, numbers) {
  const present = new Set(
    prs.map((pr) => Number(pr?.number)).filter((number) => Number.isInteger(number)),
  );
  return numbers.filter((number) => !present.has(number));
}

function escapeMarkdownCell(value) {
  return String(value ?? "TBD").replace(/\|/g, "\\|").replace(/\n/g, " ");
}

function renderPrMetricsMarkdown(metrics) {
  const rows = metrics.prs.map((pr) =>
    [
      `PR #${pr.number}`,
      pr.title,
      pr.state || "TBD",
      pr.wallclock_hours ?? "TBD",
      pr.coderabbit_reviews,
      pr.coderabbit_change_requests,
      pr.coderabbit_approvals,
      pr.url || "TBD",
    ]
      .map(escapeMarkdownCell)
      .join(" | "),
  );
  const manualRows = metrics.prs.map((pr) =>
    [
      `PR #${pr.number}`,
      pr.manual_metrics?.api_token_cost ?? "TBD",
      pr.manual_metrics?.independent_review_rework_rounds ?? "TBD",
      pr.manual_metrics?.post_merge_hotfixes_7d ?? "TBD",
      pr.manual_metrics?.operator_load ?? "TBD",
    ]
      .map(escapeMarkdownCell)
      .join(" | "),
  );
  return [
    "# PR Metrics Report",
    "",
    `Generated: ${metrics.generated_at}`,
    `Repository: ${metrics.source.repository ?? "TBD"}`,
    `PR range: ${metrics.source.pr_range}`,
    "",
    "## Summary",
    "",
    `- PR count: ${metrics.summary.pr_count}`,
    `- Merged PR count: ${metrics.summary.merged_pr_count}`,
    `- Wallclock median hours: ${metrics.summary.wallclock_hours_median ?? "TBD"}`,
    `- Wallclock max hours: ${metrics.summary.wallclock_hours_max ?? "TBD"}`,
    `- CodeRabbit reviews: ${metrics.summary.coderabbit_reviews_total}`,
    `- CodeRabbit change requests: ${metrics.summary.coderabbit_change_requests_total}`,
    `- CodeRabbit approvals: ${metrics.summary.coderabbit_approvals_total}`,
    "",
    "## PR Metrics",
    "",
    "PR | Title | State | Wallclock hours | CR reviews | CR changes | CR approvals | URL",
    "--- | --- | --- | ---: | ---: | ---: | ---: | ---",
    ...rows,
    "",
    "## Manual metrics",
    "",
    "The following PR metrics are not derivable from GitHub PR metadata. Provide --manual-metrics to fill them from dashboards or session logs; otherwise each value remains TBD.",
    "",
    "PR | API token cost | Independent review rework rounds | Post-merge hot-fixes 7d | Operator load",
    "--- | ---: | ---: | ---: | ---",
    ...manualRows,
    "",
  ].join("\n");
}

function ensureParentDir(filePath) {
  mkdirSync(dirname(resolve(filePath)), { recursive: true });
}

async function cmdPrMetrics(rest) {
  let args;
  try {
    args = parsePrMetricsArgs(rest);
  } catch (err) {
    process.stderr.write(
      `harness pr-metrics: ${err instanceof Error ? err.message : String(err)}\n`,
    );
    printPrMetricsUsage();
    return 2;
  }
  if (args.help) {
    printPrMetricsUsage(process.stdout);
    return 0;
  }
  if (!args.prRange) {
    printPrMetricsUsage();
    return 2;
  }

  let parsedRange;
  try {
    parsedRange = parsePrRange(args.prRange);
  } catch (err) {
    process.stderr.write(
      `harness pr-metrics: ${err instanceof Error ? err.message : String(err)}\n`,
    );
    printPrMetricsUsage();
    return 2;
  }

  const now = resolvePrMetricsNow();
  const today = now.toISOString().slice(0, 10);
  const outputJson = args.outputJson ?? join(process.cwd(), "docs", "metrics", "pr-metrics.json");
  const outputMd =
    args.outputMd ?? join(process.cwd(), "docs", "metrics", `pr-metrics-${today}.md`);

  try {
    let input;
    if (args.input) {
      input = readPrMetricsInput(args.input);
    } else {
      if (!commandExists("gh")) {
        throw new Error("gh CLI is required unless --input is provided");
      }
      const repository = resolvePrMetricsRepo(args.repo);
      input = {
        repository,
        prs: collectPrMetricsPrsFromGh(parsedRange.numbers, repository),
      };
    }
    const repository = args.repo ?? input.repository ?? null;
    const missingPrNumbers = findMissingPrMetricsPrNumbers(input.prs, parsedRange.numbers);
    if (missingPrNumbers.length > 0) {
      throw new Error(
        `missing PR data for requested range: ${missingPrNumbers
          .map((number) => `#${number}`)
          .join(", ")}`,
      );
    }
    const manualMetricsByNumber = args.manualMetrics
      ? readManualMetricsInput(args.manualMetrics)
      : new Map();
    const prs = filterPrMetricsPrsByRange(input.prs, parsedRange.numbers).map((pr) =>
      normalizePrMetricsPr(pr, manualMetricsByNumber),
    );
    const metrics = {
      generated_at: now.toISOString(),
      source: {
        pr_range: args.prRange,
        repository,
        input: args.input ? resolve(args.input) : "gh",
        manual_metrics: args.manualMetrics ? resolve(args.manualMetrics) : null,
      },
      summary: summarizePrMetrics(prs),
      prs,
    };

    ensureParentDir(outputJson);
    ensureParentDir(outputMd);
    writeFileSync(outputJson, JSON.stringify(metrics, null, 2) + "\n");
    writeFileSync(outputMd, renderPrMetricsMarkdown(metrics));
    process.stdout.write(`wrote ${outputJson}\n`);
    process.stdout.write(`wrote ${outputMd}\n`);
    return 0;
  } catch (err) {
    process.stderr.write(
      `harness pr-metrics: ${err instanceof Error ? err.message : String(err)}\n`,
    );
    return 1;
  }
}

// ------------------------------------------------------------
// Entry
// ------------------------------------------------------------

async function main() {
  const [sub, ...rest] = process.argv.slice(2);
  if (!sub || sub === "--help" || sub === "-h") {
    printUsage();
    return 0;
  }
  if (sub === "--version" || sub === "-v") {
    process.stdout.write(`${readVersion()}\n`);
    return 0;
  }
  switch (sub) {
    case "init":
      return cmdInit(process.cwd());
    case "check":
      return cmdCheck();
    case "doctor":
      return await cmdDoctor();
    case "rules": {
      const [action, ...args] = rest;
      if (action === "list") return await cmdRulesList();
      if (action === "test") return await cmdRulesTest(args.join(" "));
      process.stderr.write("usage: harness rules list | test <cmd>\n");
      return 2;
    }
    case "model": {
      const [action, ...args] = rest;
      if (action === "resolve") return await cmdModelResolve(args[0]);
      if (action === "check") return await cmdModelCheck(args.includes("--strict"));
      process.stderr.write(
        "usage: harness model resolve <agent> | check [--strict]\n",
      );
      return 2;
    }
    case "migrate": {
      const flagIdx = rest.indexOf("--from");
      const fromDir = flagIdx >= 0 ? rest[flagIdx + 1] : undefined;
      return await cmdMigrate(fromDir);
    }
    case "worktree-mux":
      return await cmdWorktreeMux(rest);
    case "pr-metrics":
      return await cmdPrMetrics(rest);
    default:
      process.stderr.write(`harness: unknown subcommand '${sub}'\n`);
      printUsage();
      return 2;
  }
}

main().then(
  (code) => process.exit(code ?? 0),
  (err) => {
    process.stderr.write(`harness: ${err instanceof Error ? err.message : String(err)}\n`);
    process.exit(1);
  },
);
